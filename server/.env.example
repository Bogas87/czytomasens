# ─── SERWER ───────────────────────────────────────────────────────────────────
PORT=4000

# Adres frontendu — używany w linkach do raportów wysyłanych mailem
# Lokalnie: http://localhost:5173
# Produkcja: https://czytomasens.pl
CLIENT_URL=https://czytomasens.pl

# Dodatkowy dozwolony origin (np. lokalny dev)
DEV_ORIGIN=http://localhost:5173

# ─── BAZA DANYCH ──────────────────────────────────────────────────────────────
# URL do bazy PostgreSQL
# Railway tworzy tę zmienną automatycznie po dodaniu usługi Postgres
DATABASE_URL=postgresql://user:password@localhost:5432/czytomasens

# ─── REDIS ────────────────────────────────────────────────────────────────────
# Wymagany do działania kolejki raportów (BullMQ)
# Railway tworzy tę zmienną automatycznie po dodaniu usługi Redis
REDIS_URL=redis://localhost:6379

# ─── OPENAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ─── STRIPE ───────────────────────────────────────────────────────────────────
# Klucz tajny — zaczyna się od sk_live_ (produkcja) lub sk_test_ (testy)
STRIPE_SECRET_KEY=sk_live_...

# Sekret webhooka — zaczyna się od whsec_
# Znajdziesz go w Stripe Dashboard → Developers → Webhooks → Twój endpoint
STRIPE_WEBHOOK_SECRET=whsec_...

# Cena raportu w groszach (2900 = 29 zł, 1900 = 19 zł)
PRICE_AMOUNT_GR=1900

# ─── RESEND (wysyłka maili) ───────────────────────────────────────────────────
RESEND_API_KEY=re_...

# Adres nadawcy — musi być z domeny zweryfikowanej w Resend
RESEND_FROM_EMAIL=CzyToMaSens <raporty@mail.czytomasens.pl>

# ─── BEZPIECZEŃSTWO LINKÓW ────────────────────────────────────────────────────
# Sekret do podpisywania linków do raportów w mailach
# Ustaw losowy ciąg min. 32 znaków — nie zmieniaj go po wdrożeniu,
# bo stare linki przestaną działać
# Możesz wygenerować go np. przez: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REPORT_LINK_SECRET=zmien-to-na-losowy-ciag-min-32-znakow
